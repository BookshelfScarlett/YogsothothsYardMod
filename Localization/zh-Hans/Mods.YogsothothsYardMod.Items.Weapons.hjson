Melee: {
	CrimsonScythe: {
		DisplayName: 特莉波卡的镰刀
		Tooltip:
			'''
			手持时提供[YardModBuff/YogsothothsYardMod/AntiKnockbackBuff]
			持续劈砍下，第四轮劈砍提升攻击范围
			命中时放血，释放灵魂石，并施加[YardModDebuff/Terraria/Bleeding]
			你可以可通过劈砍灵魂石，将灵魂打回原主
			你可以通过按下右键以收割灵魂石，恢复你的生命
			'''
		SpecialAttack:
			'''
			接下来的20次劈砍都会为你增加防御力
			劈砍过程中自动将场上的灵魂石进行回收
			吸收一份灵魂，并将另一份灵魂打回原主
			'''
		FlavorTooltips: 红月之下，无人能逃过她的收割
		ExtraMechanic:
			'''
			由特莉波卡携带时：
			全面强化近战属性
			提供额外防御力
			'''

		LegendaryAbility: {
			Type1:
				'''
				扩大劈砍范围
				打回原主的灵魂石伤害翻倍
				回收灵魂石时的治疗量+2
				'''
			Type2:
				'''
				扩大劈砍范围
				对敌人的放血会释放额外血弹
				血弹会尝试攻击更多敌人
				'''
			Type3:
				'''
				扩大劈砍范围
				手持提供无限飞行时间与猩红冲刺
				冲刺期间不会受到伤害
				'''
			Type4:
				'''
				扩大劈砍范围
				镰刀的命中无视防御力
				'''
		}

		KillerType: {
			OnlyCoins:
				'''
				Shift+右键以切换城镇NPC击杀选项：
				当前允许击杀NPC，仅掉落钱币
				'''
			AllStuff:
				'''
				Shift+右键以切换城镇NPC击杀选项：
				当前允许击杀城镇NPC，掉落钱币和特殊物品
				'''
			NoKilling:
				'''
				Shift+右键以切换城镇NPC击杀选项：
				当前击杀城镇NPC功能已关闭
				'''
		}
	}
}
